#!/bin/bash

set -euo pipefail

readonly url="$1"
if [[ -f "$url" ]]; then
  output="$url"
else
  output="$(mktemp -d)/download"

  if ! curl --location --fail --output "$output" "$url"; then
    echo "error: failed to download $url" >&2
    exit 1
  fi
fi

integrity="$(openssl dgst -sha256 -binary "$output" | openssl base64 -A | sed 's/^/sha256-/')"

if [[ "$output" != "$url" && -f "$output" ]]; then
  rm "$output"
fi

echo "$integrity"