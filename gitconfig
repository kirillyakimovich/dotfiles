[user]
	name = Kirill Yakimovich
	email = kirill.yakimovich@gmail.com

[core]
	attributesfile = ~/.gitattributes
	editor = nvim
	excludesfile = ~/.gitignore
	whitespace = trailing-space,space-before-tab

[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[advice]
	skippedCherryPicks = false

[branch "main"]
	pushRemote = NOPE
[branch "master"]
	pushRemote = NOPE

[alias]
	# status
	s = status

	# branch
	b = branch
	bc = branch --show-current

	# commit
	c = commit
	ca = commit --amend
	can = commit --amend --no-edit

	# network (out)
	poh = push origin HEAD

	# rev-parse
	rp = rev-parse

	# switch
	sw = switch

[diff "plist"]
	textconv = plutil -convert xml1 -o -

# https://juripakaste.fi/swift-git-attributes
[diff "swift"]
	xfuncname = ^[ \t]*(((private |public |internal |final |open )*class|(private |public |internal )*struct|(private |public |internal )*actor|(private |public |internal )*func|(private |public |internal )*extension|(private |public |internal )*enum)[ \t].*)$

[diff "zip"]
	textconv = unzip -v

[pile]
	cleanupRemoteOnSubmitFailure = true

[includeIf "hasconfig:remote.*.url:*lyft*/**"]
	path = ~/.work.gitconfig
